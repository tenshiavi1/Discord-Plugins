{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "strict": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["Revenge Plugins/**/*.ts", "Revenge Plugins/**/*.tsx", "Revenge Plugins/**/*.d.ts"],
  "exclude": ["dist", "node_modules", "Revenge Plugins/**/*.test.ts"]
}